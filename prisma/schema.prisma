generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["typedSql"]
}

datasource db {
  // vsc error is a bug, this is the correct syntax.
  provider = "postgresql"
}

// Session
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id       String @id
  email    String @unique
  username String
  files    File[]
}

model File {
  id     String  @id
  User   User?   @relation(fields: [userId], references: [id])
  userId String?
}
