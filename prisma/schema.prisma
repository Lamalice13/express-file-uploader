generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["typedSql"]
}

datasource db {
  // vsc error is a bug, this is the correct syntax.
  provider = "postgresql"
}

// Session
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  username String   @unique
  password String
  folders  Folder[]
}

model Folder {
  id     Int    @id @default(autoincrement())
  name   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  files  File[]
}

model File {
  id            Int      @id @default(autoincrement())
  original_name String
  public_id     String
  file_type     String
  bytes         Int
  uploadAt      DateTime @default(dbgenerated("NOW()"))
  path          String
  folders       Folder[]
}
