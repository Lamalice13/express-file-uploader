<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/pages/index.css">
  <title>Upload file</title>
</head>

<body>
  <%- include("partials/nav.ejs")  %>

  <% if(locals.folders && locals.folders.length > 0) { %>
  <div class="home-wrapper">
    <div>
      <h1>Drop your files</h1>
      <p class="sub-title">We accept only png and jpeg files format</p>
    </div>
    <form id="upload-form" action="/file/create" class="upload-form" method="post" enctype="multipart/form-data">
      <div class="files-wrapper">
        <input type="file" multiple name="file" id="input-files" style="display: none;" />
        <button type="button" id="input-files-btn">Click to add files</button>
        <ul id="files-list" class="files-list" aria-live="polite"></ul>
      </div>
      <% if(locals.error) { %>
      <div class="msg-wrapper">
        <p class="msg-error"><%= error %></p>
      </div>
      <% } %>

      <% if(locals.success) { %>
      <div class="msg-wrapper">
        <p class="msg-success"><%= success %> </p>
      </div>
      <% } %>

      <div aria-hidden="true" class="separator"></div>

      <div class="folders-wrapper">
        <h2>Folders</h2>
        <p class="user-advice">Check the folder(s) you want your files submit into</p>

        <% folders.forEach(f => { %>
        <div class="folder-wrapper">
          <div class="folder-group">
            <input type="checkbox" class="folder-checkbox" name="folders" value="<%= f.id %>" id="<%= f.id %>" checked>
            <label data-id="<%= f.id %>" class="folder-label" for="<%= f.id %>"><%= f.name %></label>
            <button type="button" class="span-folder" aria-label="Click to modify the folder <%= f.name %>">
              ✏️
            </button>
            <a href="/folder/<%= f.id %>" aria-label="Click to see folder details <%= f.name %>">🔍</a>
            <button type="button" class="delete" data-id="<%= f.id %>" aria-label="Click to delete folder <%= f.name %>">❌</button>
          </div>
          <div id="folder-msg-<%= f.id %>" class="msg-wrapper"></div>
        </div>
        <% }) %>
      </div>
    </form>


    <form action="/folder/create" method="post" class="add-folder">
      <label for="folder_name">Folder's name</label>
      <input type="text" name="folder_name" id="folder_name" class="folder-name-input">
      <button type="submit" id="btn-add-folder" class="btn-add-folder">Create</button>
    </form>



    <div aria-hidden="true" class="separator"></div>

    <button form="upload-form" type="submit" class="submit" disabled="true">Submit</button>
    <p id="msg-submit-success" class="msg-submit-success"></p>
  </div>

  <% } else { %>
  <h1>You'll need first to create a folder!</h1>
  <form action="/folder/create" method="post" class="form-no-folder">
    <label for="folder_name">Folder's name</label>
    <input type="text" name="folder_name" id="folder_name">
    <button type="submit">Create</button>
  </form>
  <% } %>



  <script>
    const deleteBtn = document.querySelectorAll(".delete")
    const spans = document.querySelectorAll(".span-folder")
    const inputFilesBtn = document.getElementById("input-files-btn")
    const filesUl = document.getElementById("files-list")
    const inputFiles = document.getElementById("input-files")
    const dataTransfer = new DataTransfer();
    const ALLOWED = ["image/jpeg", "image/png"];
    const btnSubmitSuccess = document.getElementById("msg-submit-success")
    const foldersCheckbox = document.querySelectorAll(".folder-checkbox")
    const submitBtn = document.querySelector(".submit")

    async function deleteFolder(btn) {
      const folderId = btn.dataset.id;
      if (!confirm("Are you sure?")) return;

      try {
        const res = await fetch(`/folder/${folderId}`, {
          method: "DELETE",
        });

        window.location.href = "/home";
      } catch (err) {
        console.error(err);
      }
    }

    if (deleteBtn) {
      deleteBtn.forEach(btn => {
        btn.addEventListener("click", () => {
          deleteFolder(btn)
        })
      })
    }

    async function updateInput(label) {
      const newValue = label.textContent
      const id = label.dataset.id;
      if (newValue === label.dataset.value || newValue == "") {
        label.textContent = label.dataset.value
      } else {
        try {
          const res = await fetch(`/folder/${id}/`, {
            method: "PATCH",
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              folderName: newValue
            })
          })

          const data = await res.json()
          const p = document.createElement("p")
          const folderMsgContainer = document.getElementById(`folder-msg-${id}`)

          if (!res.ok) {
            p.classList.add("msg-error")
            p.textContent = data.errors[0].msg
            label.textContent = label.dataset.value
          } else {
            p.classList.add("msg-success")
            p.textContent = data.msg
            label.dataset.value = newValue
            label.textContent = newValue
          }
          folderMsgContainer.replaceChildren(p)
        } catch (e) {
          throw new Error(e)
        }
      }
    }

    function makeLabelEditable(label) {
      label.contentEditable = true;
      label.focus()

      const range = document.createRange();
      range.selectNodeContents(label)
      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(range);
      label.dataset.value = label.textContent
    }

    if (spans) {
      spans.forEach(span => {
        const label = span.parentElement.querySelector("label")

        span.addEventListener("click", () => {
          makeLabelEditable(label)
        })
        label.addEventListener("blur", () => {
          updateInput(label)
          label.contentEditable = "false"
        })
        label.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === "Escape") {
            return label.blur()
          }
        })
      })
    }



    // If none of the submit btn are checked, unallowed submit upload file 
    foldersCheckbox.forEach(input => {
      input.addEventListener("click", () => {
        const isChecked = [...foldersCheckbox].some(input => input.checked)
        submitBtn.disabled = !(isChecked && dataTransfer.files.length > 0)
        console.log(submitBtn.disabled)
      })
    })


    function addFileList() {
      for (const file of inputFiles.files) {
        const {
          type
        } = file
        if (!ALLOWED.includes(type)) {
          alert('Wrong type of file!')
          continue
        } else {
          dataTransfer.items.add(file);
          const li = document.createElement("li")
          li.textContent = file.name
          filesUl.appendChild(li)
        }
      }
      submitBtn.disabled = dataTransfer.files.length === 0
      inputFiles.files = dataTransfer.files;
    }

    inputFilesBtn.addEventListener("click", () => inputFiles.click());
    inputFiles.addEventListener("change", addFileList)
  </script>
</body>

</html>