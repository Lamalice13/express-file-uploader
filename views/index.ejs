<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/pages/index.css">
  <title>Upload file</title>
</head>

<body>

  <% if(locals.folders && locals.folders.length > 0) { %>
  <h1>Drop your files</h1>

  <form id="upload-form" action="/" method="post" enctype="multipart/form-data">
    <div id="inputs-file" class="inputs-file">
      <div class="input-file-group">
        <input type="file" name="file" id="file" />
        <button type="button" id="btn-add" class="btn-add"></button>
      </div>
    </div>


    <div class="folders">
      <h2>Folders</h2>
      <p>Check the folder(s) you want your files submit into</p>
      <% folders.forEach(f => { %>
      <div class="folder-group">
        <input type="checkbox" name="folders" value="<%= f.id %>" id="<%= f.id %>" checked>
        <label data-id="<%= f.id %>" class="folder-label" for="<%= f.id %>"><%= f.name %></label>
        <button type="button" class="span-folder" aria-label="Click to modify the folder named <%= f.name %>">
          ✏️
        </button>
        <button type="button"><a href="/folder/<%= f.id %>">🔍</a></button>
        <button type="button" class="delete" data-id="<%= f.id %>">❌</button>
      </div>
      <% }) %>
    </div>
  </form>

  <form action="/create/folder" method="post" class="add-folder">
    <label for="folder_name">Folder's name</label>
    <input type="text" name="folder_name" id="folder_name" class="folder-name-input">
    <button type="submit" id="btn-add-folder" class="btn-add-folder">Create</button>
  </form>

  <button form="upload-form" type="submit" class="submit">Submit</button>

  <% } else { %>
  <h1>You'll need first to create a folder!</h1>
  <form action="/create/folder" method="post" class="form-no-folder">
    <label for="folder_name">Folder's name</label>
    <input type="text" name="folder_name" id="folder_name">
    <button type="submit">Create</button>
  </form>
  <% } %>



  <script>
    const div = document.getElementById("inputs");

    const bigDiv = document.getElementById("inputs-file")
    let btnCountInput = 1

    function createAddBtn() {
      const btn = document.createElement("button")
      btn.type = "button";
      btn.id = "btn-add";
      btn.className = "btn-add";
      btn.textContent = "Add another file";

      btn.addEventListener("click", () => {
        btnCountInput++

        const div = document.createElement("div")
        div.className = "input-file-group"

        const input = document.createElement("input");
        input.name = "file"
        input.type = "file"

        div.appendChild(input);

        if (btnCountInput < 4) {
          const newBtn = createAddBtn()
          div.appendChild(newBtn)
          btn.remove();
        } else {
          btn.style.visibility = "hidden"
        }
        bigDiv.appendChild(div)
      })
      return btn;
    }


    const initialBtnInput = document.getElementById("btn-add")
    if (initialBtnInput) {
      initialBtnInput.replaceWith(createAddBtn())
    }

    const initialBtnFolder = document.getElementById("btn-add-folder")


    const deleteBtn = document.querySelectorAll(".delete")
    if (deleteBtn) {
      deleteBtn.forEach(btn => {
        btn.addEventListener("click", async () => {
          const folderId = btn.dataset.id;
          if (!confirm("Are you sure?")) return;

          try {
            const res = await fetch(`/folders/${folderId}`, {
              method: "DELETE",
            });

            if (!res.ok) throw new Error("Delete failed");

            window.location.href = "/";
          } catch (err) {
            console.error(err);
          }
        })
      })
    }



    const spans = document.querySelectorAll(".span-folder")
    if (spans) {
      function updateInput(label) {
        const newValue = label.textContent
        const id = label.dataset.id;
        if (newValue === label.dataset.value || newValue == "") {
          label.textContent = label.dataset.value
        } else {
          label.textContent = newValue
        }
        fetch(`/update/folder/${id}/`, {
          method: "PATCH",
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            folderName: newValue
          })
        })
      }

      spans.forEach(span => {
        const label = span.parentElement.querySelector("label")

        span.addEventListener("click", () => {
          label.contentEditable = true;
          label.focus()

          const range = document.createRange();
          range.selectNodeContents(label)
          const selection = window.getSelection();
          selection.removeAllRanges();
          selection.addRange(range);
          label.dataset.value = label.textContent
        })
        label.addEventListener("blur", () => {
          updateInput(label)
        })
        label.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === "Escape") {
            return label.blur()
          }
        })
      })
    }
  </script>
</body>

</html>