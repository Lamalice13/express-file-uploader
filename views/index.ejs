<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Upload file</title>
</head>

<body>
  <h1 style="margin: 0;">Drop your files</h1>

  <% if(locals.folders && locals.folders.length > 0) { %>

  <form id="upload-form" action="/" method="post" enctype="multipart/form-data">
    <br>
    <img src="/icons/plus.svg" id="plus-icon" alt="plus" width="25" style="cursor: pointer;">
    <div id="inputs" style="display: flex; flex-direction: column; gap: 10px; ">
      <input type="file" name="file1" id="file" />
    </div>
    <br>
    <fieldset>
      <legend>Select the folder(s) you want to put your file(s) into</legend>
      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        <% folders.forEach(f => { %>
        <div style="display: flex; gap: 1rem;">
          <span class="span-folder" style="cursor: pointer;" aria-label="Click to modify the folder named <%= f.name %>">
            ✏️
          </span>
          <label data-id="<%= f.id %>" class="folder-label" for="<%= f.id %>"><%= f.name %></label>
          <input type="checkbox" name="folders" value="<%= f.id %>" id="<%= f.id %>" checked>
          <a href="/folder/<%= f.id %>">🔍</a>
          <button type="button" class="delete" data-id="<%= f.id %>">❌</button>
          <div>
          </div>
        </div>
        <% }) %>
      </div>
  </form>
  <form action="/create/folder" method="post">
    <label for="folder_name">Add a folder</label>
    <input type="text" name="folder_name" id="folder_name">
    <button type="submit">Create folder</button>
  </form>
  </fieldset>
  <button form="upload-form" type="submit" style="display: block; margin-top: 2%;">Submit</button>




  <% } else { %>
  <p>You'll need first to create a folder!</p>
  <form action="/create/folder" method="post">
    <label for="folder_name">Folder's name</label>
    <input type="text" name="folder_name" id="folder_name">
    <button type="submit">Create folder</button>
  </form>
  <% } %>

  <style>
    input[type="file"]::file-selector-button {
      cursor: pointer;
    }
  </style>

  <script>
    const icon = document.getElementById("plus-icon");
    const div = document.getElementById("inputs");
    let count = 2;

    if (icon) {

      icon.addEventListener("click", () => {
        div.innerHTML += `<input type="file" name="file${count}" id="file${count++}">`
      })
      const deleteBtn = document.querySelectorAll(".delete")

      deleteBtn.forEach(btn => {
        btn.addEventListener("click", async () => {
          const folderId = btn.dataset.id;
          if (!confirm("Are you sure?")) return;

          try {
            const res = await fetch(`/folders/${folderId}`, {
              method: "DELETE",
            });

            if (!res.ok) throw new Error("Delete failed");

            window.location.href = "/";
          } catch (err) {
            console.error(err);
          }
        })
      })

    }
    const spans = document.querySelectorAll(".span-folder")
    if (spans) {
      function updateInput(label) {
        const newValue = label.textContent
        const id = label.dataset.id;
        if (newValue === label.dataset.value || newValue == "") {
          label.textContent = label.dataset.value
        } else {
          label.textContent = newValue
        }
        fetch(`/update/folder/${id}/`, {
          method: "PATCH",
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            folderName: newValue
          })
        })
      }

      spans.forEach(span => {
        const label = span.nextElementSibling
        span.addEventListener("click", () => {
          label.contentEditable = true;
          label.focus()
          label.dataset.value = label.textContent
        })
        label.addEventListener("blur", () => {
          updateInput(label)
        })
        label.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === "Escape") {
            return label.blur()
          }
        })
      })
    }
  </script>
</body>

</html>