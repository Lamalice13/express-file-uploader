<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Folder</title>
</head>

<body>
  <% if(locals.files) {%>
  <% files.forEach(file => { %>
  <div>
    <p><%= "File name: " + file.original_name%></p>
    <p><%= file.bytes + " bytes"%></p>
    <a href="/download/<%= file.id %>" class="btn">Télécharger</a>
    <hr>
  </div>
  <% }) %>
  <% } %>
  <a href="/">Go back</a>
</body>

</html>