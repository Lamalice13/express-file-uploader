<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/pages/folder.css">
  <title>Folder</title>
</head>

<body>
  <%- include("partials/nav.ejs")  %>
  <% if(locals.files && locals.files.length > 0) {%>
  <div class="file-group">
    <% files.forEach(file => { %>
    <div class="file-card">
      <p class="file-name"><%= file.original_name %></p>
      <p><%= file.bytes + " bytes"%></p>
      <a href="/file/<%= file.id %>/download" class="btn">Télécharger</a>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <h1 class="no-file">You have no files in this folder! :(</h1>
  <% } %>
  <a class="btn-last" href="/">Go back</a>

</body>

</html>